NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# libSQL/SQLite file. Mount ./data as a Coolify volume in production.
DATABASE_URL=file:./data/rasputin.db

# Better Auth. Secret must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Public origin Coolify (or local gateway) serves. Used for Google OAuth callbacks.
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth (required in production). Authorized redirect:
#   {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated, case-insensitive. Required and non-empty in production.
RASPUTIN_ALLOWED_EMAILS=you@example.com

# Winnow companion UI on the Windows host-only IP — not localhost.
WINNOW_UPSTREAM=http://192.168.56.1:3210
WINNOW_UI_TOKEN=replace-with-winnow-remote-token

# Optional later preview ports on the same Windows host (comma-separated).
# PREVIEW_PORTS=5173,3000,8080

# Break-glass operator (email/password). Created on first boot if missing.
# Password min 12 characters. Email must also be on RASPUTIN_ALLOWED_EMAILS.
SEED_OPERATOR_EMAIL=you@example.com
SEED_OPERATOR_PASSWORD=change-this-operator-password
SEED_OPERATOR_NAME=Operator
